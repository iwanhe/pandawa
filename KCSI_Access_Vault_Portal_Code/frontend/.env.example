# Base URL ORDS (schema alias sesuai APEX Instance Admin > ORDS Rest Config)
VITE_ORDS_BASE_URL=https://apps.kdk-id.com/ords/apx

# NOTE: OAuth client_id / client_secret TIDAK diletakkan di sini (di sisi browser).
# client_secret hanya di-set sebagai server-side env var di Netlify Function
# (ORDS_BASE_URL, OAUTH_CLIENT_ID, OAUTH_CLIENT_SECRET) - lihat netlify/functions/token.js
