# Contoh variabel lingkungan (NST-701). Salin menjadi .env untuk pengembangan lokal.
# (Disimpan tanpa titik di depan karena alat sinkronisasi menolak nama .env*.)
# Nilai rahasia sungguhan tidak pernah di-commit; di server diisi dari secret store.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://app:ganti-saya@localhost:5432/supplier
AUTH_ISSUER=https://idp.contoh.id/realms/pandawa
AUTH_AUDIENCE=supplier-api
AUTH_JWKS_URL=https://idp.contoh.id/realms/pandawa/protocol/openid-connect/certs
CORS_ORIGINS=https://supplier.contoh.id
