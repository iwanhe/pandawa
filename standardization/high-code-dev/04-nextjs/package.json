{
  "name": "pandawa-standar-nextjs",
  "version": "0.2.0",
  "description": "Konfigurasi dan contoh Standar Next.js PANDAWA",
  "scripts": {
    "dev": "next dev examples/benar-app",
    "build": "next build examples/benar-app",
    "lint": "eslint . --ignore-pattern \"examples/salah/**\" --max-warnings 0",
    "lint:benar": "eslint examples/benar-app --max-warnings 0",
    "lint:salah": "eslint examples/salah",
    "typecheck": "tsc --noEmit -p examples/benar-app/tsconfig.json",
    "format:check": "prettier --check ."
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
