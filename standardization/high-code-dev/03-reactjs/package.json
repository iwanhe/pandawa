{
  "name": "pandawa-standar-react",
  "version": "0.2.0",
  "description": "Konfigurasi dan contoh Standar ReactJS PANDAWA",
  "scripts": {
    "lint": "eslint . --ignore-pattern \"examples/salah/**\" --max-warnings 0",
    "lint:benar": "eslint examples/benar --max-warnings 0",
    "lint:salah": "eslint examples/salah",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
