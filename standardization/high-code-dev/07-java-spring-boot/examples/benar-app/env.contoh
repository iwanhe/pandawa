# Contoh variabel lingkungan (JSB-606, JSB-701). Salin menjadi .env untuk pengembangan lokal.
# (Disimpan tanpa titik di depan karena alat sinkronisasi menolak nama .env*.)
# Nilai rahasia sungguhan tidak pernah di-commit; di server diisi dari secret store.
PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/supplier
