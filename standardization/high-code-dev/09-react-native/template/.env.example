# Salin menjadi .env (development) atau .env.<APP_ENV> (mis. .env.uat, .env.prod).
#
# PERINGATAN (RN-802): semua nilai di file ini MASUK KE BUNDLE aplikasi dan dapat dibaca
# siapa pun yang memegang APK/IPA. Jangan menaruh secret, password, client secret,
# atau API key privat di sini. Hanya konfigurasi publik.
APP_ENV_NAME=dev
API_BASE_URL=https://api-dev.example.co.id
API_TIMEOUT_MS=15000
