{
  "name": "pandawa-rn-template",
  "version": "0.1.0",
  "private": true,
  "description": "Template aplikasi React Native standar PANDAWA (diturunkan dari mobile-boilerplate-reactnative)",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm test && npm run format:check",
    "bundle:check": "react-native bundle --platform android --entry-file index.js --dev false --bundle-output /tmp/pandawa-rn-check.bundle"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "axios": "1.21.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-keychain": "10.0.0",
    "react-native-safe-area-context": "5.11.0",
    "react-native-screens": "4.30.1",
    "react-native-toast-message": "2.5.2",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.10",
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-plugin": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-native": "5.0.0",
    "globals": "17.13.0",
    "jest": "29.7.0",
    "prettier": "3.9.10",
    "react-native-dotenv": "5.0.0",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
