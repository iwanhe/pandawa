# Salin file ini menjadi .npmrc di root proyek.
# Standar PANDAWA (JS-806, RN-108): install script paket pihak ketiga tidak dijalankan otomatis,
# dan versi dependency disimpan tepat (tanpa ^ atau ~).
ignore-scripts=true
save-exact=true
# eslint-plugin-react-native 5.0 dan @react-native/eslint-plugin belum mencantumkan ESLint 10
# di peerDependencies. Hapus baris ini setelah plugin tersebut diperbarui.
legacy-peer-deps=true
